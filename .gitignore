# Create .gitignore file
echo "# Dependencies
node_modules/
venv/
__pycache__/
*.pyc

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build files
/build
/dist
/backend/build

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Database
*.sql
*.sqlite

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backend
backend/venv/
backend/__pycache__/
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/

# Frontend
frontend/myapp/node_modules/
frontend/myapp/build/
frontend/myapp/.env" > .gitignore